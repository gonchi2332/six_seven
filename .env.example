# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (DOCKER)
# ==========================================
DB_USER=sixseven
DB_PASSWORD=ingresa_una_contrasena_segura_aqui
DB_NAME=sixseven_db
# Nota: La URL usa el nombre del contenedor de la BD ('sixseven_db') como host interno
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@sixseven_db:5432/${DB_NAME}

# ==========================================
# ENTORNO Y SERVIDOR
# ==========================================
NODE_ENV=production
PORT=3000

# ==========================================
# SEGURIDAD Y AUTENTICACIÓN (JWT)
# ==========================================
JWT_EXPIRES_IN=1d
JWT_SECRET=ingresa_un_secreto_generico_aqui
ACCESS_TOKEN_SECRET=ingresa_secreto_para_access_token_aqui
REFRESH_TOKEN_SECRET=ingresa_secreto_para_refresh_token_aqui

# ==========================================
# CREDENCIALES DE CORREO (NODEMAILER)
# ==========================================
SEND_EMAIL_HOST=smtp.gmail.com
SEND_EMAIL_USER=ingresa_correo_del_laboratorio@gmail.com
SEND_EMAIL_PASSWORD=ingresa_password_de_aplicacion_gmail
SEND_USER=SixSeven

# ==========================================
# INTEGRACIONES DE INTELIGENCIA ARTIFICIAL
# ==========================================
# Groq (Modelos LLM)
GROQ_API_KEY=ingresa_tu_api_key_de_groq_aqui
GROQ_AI_MODEL=llama-3.3-70b-versatile

# OpenRouter (Modelos de Visión)
OPENROUTER_API_KEY=ingresa_tu_api_key_de_openrouter_aqui
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# Hugging Face (Moderación NSFW)
HUGGING_FACE_API_KEY=ingresa_tu_api_key_de_huggingface_aqui
HUGGING_FACE_AI_MODEL=Falconsai/nsfw_image_detection
